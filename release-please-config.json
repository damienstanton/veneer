{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "veneer",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "verifier/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "verifier/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='veneer')].version"
        },
        "verifier/src/mcp.rs"
      ]
    }
  }
}
